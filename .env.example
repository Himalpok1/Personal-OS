# Copy this file to .env and fill in real local-dev values.
# .env is gitignored — never commit real credentials.

# Postgres superuser, used only by the container's own init/admin tooling —
# never connected to by the API, worker, or migrations.
POSTGRES_SUPERUSER_PASSWORD=changeme_superuser

# Postgres role passwords, used both by docker-compose (to create the roles)
# and by DATABASE_URL/MIGRATIONS_DATABASE_URL below (to connect as them).
POSTGRES_MIGRATOR_PASSWORD=changeme_migrator
POSTGRES_APP_PASSWORD=changeme_app

# Least-privilege runtime role — used by apps/api and apps/worker.
DATABASE_URL=postgresql://posops_app:changeme_app@127.0.0.1:5432/personalos

# DDL-rights role — used only to run migrations (Drizzle schema + the
# one-time pg-boss schema migration), never by a running service.
MIGRATIONS_DATABASE_URL=postgresql://posops_migrator:changeme_migrator@127.0.0.1:5432/personalos

# A separate database so apps/api's/apps/worker's test suites can truncate
# freely without touching dev data. Not used by any running service, only
# by `vitest`. Create it once locally: `createdb personalos_test` (or the
# equivalent docker exec), then run migrations against
# TEST_MIGRATIONS_DATABASE_URL the same way as the dev database.
TEST_DATABASE_URL=postgresql://posops_app:changeme_app@127.0.0.1:5432/personalos_test
TEST_MIGRATIONS_DATABASE_URL=postgresql://posops_migrator:changeme_migrator@127.0.0.1:5432/personalos_test

PORT=3000

# Shared filesystem between apps/api (writes) and apps/worker (reads/deletes)
# for PTT recordings awaiting transcription. Defaults to /tmp/personal-os-audio
# if unset -- only needs overriding in Docker, where docker-compose.yml
# already points both containers at the same audio_data volume mount.
AUDIO_STORAGE_PATH=/tmp/personal-os-audio

# Master key protecting AI provider API keys at rest (AES-256-GCM), used by
# both apps/api and apps/worker. Must decode from base64 to exactly 32
# bytes. Generate with: openssl rand -base64 32
# No per-vendor API key env vars exist — provider credentials are entered
# via POST /ai/providers and stored encrypted in Postgres, not hardcoded.
CREDENTIALS_ENCRYPTION_KEY=changeme_generate_with_openssl_rand_base64_32

# Phase 2 web deployment (docker-compose.yml's "web" service).
# PUBLIC_API_URL is baked into the web build at Docker build time (Expo
# inlines EXPO_PUBLIC_* at bundle time) -- the browser calls this URL
# directly, so it must be reachable from wherever the web app is opened,
# not just from inside the Docker network. Local dev: the API's own
# localhost URL. Production: the API's public Tailscale Serve URL.
PUBLIC_API_URL=http://localhost:3000

# CORS allowlist for apps/api -- must include whatever origin the web app
# is actually served from. Defaults (set in apps/api/src/env.ts) already
# cover the local Metro dev server ports, so this is only needed to add the
# production web origin (a different Tailscale Serve port than the API's).
WEB_APP_ORIGIN=http://localhost:8081,http://localhost:8082,http://localhost:19006
