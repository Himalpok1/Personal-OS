# Copy this file to .env (repo-wide convention: .env is gitignored everywhere).
#
# The real .env MAY CONTAIN SECRETS -- an Expo access token, for example. It
# must stay gitignored, and no value from it may be committed, logged, or
# pasted into docs. Only EXPO_PUBLIC_* values are safe to treat as public, and
# only because Expo inlines them into the JS bundle; never give a secret an
# EXPO_PUBLIC_ prefix.
#
# EXPO_PUBLIC_* vars are inlined into the bundle at build/dev time by
# Expo's Metro config. Local dev default points at apps/api's default
# port; the production static export bakes in the real Tailscale URL
# instead, via the PUBLIC_API_URL build arg in the repo root .env (see
# apps/mobile/Dockerfile).
EXPO_PUBLIC_API_URL=http://localhost:3000

# Checkpoint 4.5 Stage A spike only. Non-secret Google Web OAuth client id
# (requestOfflineAccess() webClientId) -- the matching client secret lives
# only in the root .env / apps/api, never here.
EXPO_PUBLIC_GOOGLE_OAUTH_CLIENT_ID=
